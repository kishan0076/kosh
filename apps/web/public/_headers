# Security headers for the production web app (Cloudflare Pages / Netlify format, §10).
# These do NOT apply in Vite dev (which serves index.html directly), so HMR is unaffected.
#
# connect-src allows 'self' plus any https origin so the API and presigned-R2 PUTs work
# regardless of host; tighten it to your exact API + R2 origins once they're fixed.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' https:; worker-src 'self'; manifest-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
