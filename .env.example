# ── Web app (apps/web) ───────────────────────────────────────────────────────
# The demo runs fully client-side and needs none of these. Set VITE_API_URL only
# once the backend exists and you want the web app to talk to it.
VITE_API_URL=http://localhost:8787

# ── API (future — apps/api, per docs/kosh-build-plan-v3.md) ───────────────────
# Local dev points at the docker-compose services in infra/.
MONGODB_URI=mongodb://localhost:27017/kosh

# Cloudflare R2 (MinIO locally): setting R2_ENDPOINT switches the S3 client to
# path-style addressing so the same code works against MinIO and R2.
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=kosh
R2_SECRET_ACCESS_KEY=kosh-secret
R2_BUCKET=kosh
# R2_ACCOUNT_ID=            # set instead of R2_ENDPOINT in production

# Auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=change-me
ENCRYPTION_KEY=change-me-32-bytes-min
ALLOWED_GITHUB_LOGINS=your-github-login
DEV_LOGIN=1                 # allow POST /auth/dev-login without OAuth (dev only)

# Optional: a server GitHub token used for enrichment when a user hasn't connected OAuth
KOSH_GITHUB_TOKEN=

# Scheduled jobs (nightly trash purge · weekly repo refresh)
ENABLE_JOBS=0

# Integrations
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
EMAIL_INBOUND_SECRET=

# URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
