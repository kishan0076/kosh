# ── Web app (apps/web) ───────────────────────────────────────────────────────
# The demo runs fully client-side and needs none of these. Set VITE_API_URL only
# when you want the web app to talk to the API. Include the /api base path —
# every API route is mounted under /api. Both apps read this file from the repo root.
VITE_API_URL=http://localhost:8787/api

# ── API (apps/api) ───────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Storage: leave MONGODB_URI unset to use the built-in in-memory/JSON store, which
# runs anywhere with no database. Point it at a hosted MongoDB (e.g. Atlas) to persist.
# MONGODB_URI=mongodb://localhost:27017/kosh
DATA_DIR=.data

# Object storage: leave the R2 keys unset to use the local filesystem store
# (files land under DATA_DIR). Fill these in to use Cloudflare R2 — setting
# R2_ENDPOINT switches the S3 client to path-style addressing.
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kosh
# R2_ACCOUNT_ID=            # set instead of R2_ENDPOINT in production

# ── Auth ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me
ENCRYPTION_KEY=change-me-32-bytes-min
DEV_LOGIN=1                 # allow POST /auth/dev-login without OAuth (dev only)
COOKIE_SECURE=0
ALLOWED_GITHUB_LOGINS=      # comma-separated logins; empty = allow any

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional server GitHub token used for enrichment when a user hasn't connected OAuth.
KOSH_GITHUB_TOKEN=

# ── Scheduled jobs (nightly trash purge · weekly repo refresh) ────────────────
ENABLE_JOBS=0

# ── Integrations (all optional; features degrade gracefully when unset) ────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_DAILY_CAP_USD=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
EMAIL_INBOUND_SECRET=
EMAIL_ALLOWED_SENDERS=      # comma-separated addresses/domains; required in production

# ── URLs ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
